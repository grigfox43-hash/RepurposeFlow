# RepurposeFlow - Environment Variables Configuration

# 1. Google Gemini AI API (Required for live AI generation)
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. n8n Automation Engine (Optional, for external webhook orchestration)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/repurposeflow-job
REPURPOSEFLOW_WEBHOOK_SECRET=your_super_secret_webhook_key_here

# 3. Supabase (Database & Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Cloudflare R2 / AWS S3 (Media Storage)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=repurposeflow-media
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
