{
  "name": "RepurposeFlow - Gemini 2.0 Multimodal Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "repurposeflow-job",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "webhook-start",
      "name": "Webhook: Ingest Job",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "repurposeflow-job-hook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key={{$env.GEMINI_API_KEY}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Ты — главный контент-стратег RepurposeFlow. Проанализируй подкаст или аудио-запись: '{{$json.body.title}}' (Тон: {{$json.body.tone}}, Язык: {{$json.body.language}}). Сгенерируй 15 форматов: LinkedIn тред, статью для VC.ru, 3 сценария Reels с 3-секундными хуками, Telegram дайджест, Email рассылку и цитаты. Верни структурированный JSON с массивом публикаций.\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"temperature\": 0.7,\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "id": "gemini-processor",
      "name": "Google Gemini 2.0 Flash AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$json.body.callbackUrl || 'https://your-repurposeflow-domain.vercel.app/api/webhooks/n8n-complete'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Repurpose-Secret",
              "value": "={{$env.REPURPOSEFLOW_WEBHOOK_SECRET}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jobId\": \"{{$node['Webhook: Ingest Job'].json.body.jobId}}\",\n  \"status\": \"completed\",\n  \"geminiResponse\": {{$json.candidates[0].content.parts[0].text}}\n}",
        "options": {}
      },
      "id": "callback-site",
      "name": "Callback to RepurposeFlow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 300]
    }
  ],
  "connections": {
    "Webhook: Ingest Job": {
      "main": [
        [
          {
            "node": "Google Gemini 2.0 Flash AI",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini 2.0 Flash AI": {
      "main": [
        [
          {
            "node": "Callback to RepurposeFlow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
